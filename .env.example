# ─── Backend ──────────────────────────────────────────────────────────────────
# PostgreSQL (Render)
DATABASE_URL=postgresql://user:password@host:5432/fila_digital

# Redis (optional, falls back to in-memory cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production

# App
PORT=7070
NODE_ENV=development

# Sentry (backend)
SENTRY_DSN=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Backend API base URL
NEXT_PUBLIC_FILA_DIGITAL_BASE_URL=http://localhost:7070

# Sentry (frontend)
NEXT_PUBLIC_SENTRY_DSN=
