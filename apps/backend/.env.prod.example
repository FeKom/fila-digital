# ─────────────────────────────────────────────────────────────────────────────
# Fila Digital — Production Environment Variables
# Copy this file to .env.prod and fill in all values before deploying.
#
#   cp .env.prod.example .env.prod
#
# NEVER commit .env.prod to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ────────────────────────────────────────────────────────────────────
# Base domain used by Traefik to generate subdomains:
#   api.<DOMAIN>         → Node.js API
#   grafana.<DOMAIN>     → Grafana dashboards
#   prometheus.<DOMAIN>  → Prometheus (basic-auth protected)
#   traefik.<DOMAIN>     → Traefik dashboard (basic-auth protected)
DOMAIN=yourdomain.com

# ── Traefik Dashboard Basic Auth ──────────────────────────────────────────────
# Format: user:bcrypt_hashed_password
# Generate with:
#   echo $(htpasswd -nB admin) | sed -e s/\\$/\\$\\$/g
# The double $$ is required for Docker Compose variable escaping.
TRAEFIK_BASIC_AUTH=admin:$$2y$$05$$examplehashedpasswordhere

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token for the cloudflared daemon.
# How to get it:
#   1. Go to https://one.dash.cloudflare.com → Networks → Tunnels
#   2. Create a tunnel, choose "Docker" as the connector type
#   3. Copy the token from the install command shown in the dashboard
#   4. Add public hostname routes pointing to http://traefik:80:
#        api.<DOMAIN>        → http://traefik:80
#        grafana.<DOMAIN>    → http://traefik:80
#        prometheus.<DOMAIN> → http://traefik:80
#        traefik.<DOMAIN>    → http://traefik:80
CF_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# ── GitHub Container Registry ─────────────────────────────────────────────────
# Used to pull the Docker image built by GitHub Actions.
# Format: <github-owner>/<repository-name>  (lowercase, no ghcr.io prefix)
# Example: myusername/fila-digital-backend
GITHUB_REPOSITORY=your-github-username/fila-digital-backend

# ── Application ───────────────────────────────────────────────────────────────
PORT=7070
AUTH_TOKEN=change-me-to-a-long-random-secret

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_NAME=filadigital
DATABASE_USER=filadigital_user
DATABASE_PASSWORD=change-me-to-a-strong-password

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-to-a-strong-password

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Traces are sent to Grafana Tempo via OTLP HTTP.
# Point this at your Tempo instance (e.g. OCI VM running Coolify).
# Leave empty to disable tracing entirely (zero overhead).
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=fila-digital-api

# ── Sentry ────────────────────────────────────────────────────────────────────
# Error tracking — leave empty to disable (the Sentry SDK runs as a no-op).
# Get your DSN at: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
