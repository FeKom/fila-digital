{
  "title": "Fila Digital",
  "uid": "fila-digital-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "tags": ["fila-digital"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Rate by Level",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warn" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "info" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum by (level) (rate({app=\"fila-digital-api\"}[1m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors (last 5m)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(count_over_time({app=\"fila-digital-api\", level=\"error\"}[5m]))",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 3,
      "title": "Warnings (last 5m)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(count_over_time({app=\"fila-digital-api\", level=\"warn\"}[5m]))",
          "legendFormat": "warnings"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests Completed (last 5m)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 4, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(count_over_time({app=\"fila-digital-api\"} |= \"request completed\" [5m]))",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request Rate",
      "type": "stat",
      "gridPos": { "x": 20, "y": 4, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "sum(rate({app=\"fila-digital-api\"} |= \"request completed\" [1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 10,
      "title": "Response Time Percentiles (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "quantile_over_time(0.99, {app=\"fila-digital-api\"} | json | responseTime != \"\" | unwrap responseTime [1m]) by ()",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "quantile_over_time(0.95, {app=\"fila-digital-api\"} | json | responseTime != \"\" | unwrap responseTime [1m]) by ()",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "quantile_over_time(0.50, {app=\"fila-digital-api\"} | json | responseTime != \"\" | unwrap responseTime [1m]) by ()",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": { "dedupStrategy": "none", "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "wrapLogMessage": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "{app=\"fila-digital-api\", level=\"error\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 7,
      "title": "All Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "options": { "dedupStrategy": "none", "showTime": true, "sortOrder": "Descending", "enableLogDetails": true, "wrapLogMessage": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "{app=\"fila-digital-api\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
